# Copy this file to .env and fill in real values.
# Make sure .gitignore contains ".env" BEFORE you create it.

# ============================================================
# Supabase
# ============================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# LLM routing
# ------------------------------------------------------------
# Pick which configured provider handles which task.
# Classification is high volume and forgiving  -> cheap model.
# Briefings are low volume and quality-critical -> better model.
# Both may point at the same provider.
# ============================================================
LLM_DEFAULT_PROVIDER=
LLM_CLASSIFY_PROVIDER=
LLM_BRIEF_PROVIDER=

# ============================================================
# Xiaomi MiMo
# ------------------------------------------------------------
# Two endpoints are available. Use ONE at a time.
#
# OpenAI-compatible (recommended - supports response_format):
MIMO_PROTOCOL=
MIMO_BASE_URL=
MIMO_API_KEY=
MIMO_MODEL=
#
# Anthropic-compatible (JSON forced via assistant prefill instead):
# MIMO_PROTOCOL=anthropic
# MIMO_BASE_URL=https://api.mimo.mi.com/anthropic
# MIMO_MODEL=mimo-v2.5
#
# NOTE: the mimo-v2-* model names were decommissioned on 2026-06-30.
# Use the v2.5 series. Confirm the exact base_url paths and model
# strings against your dashboard - the URLs above are the shape to
# expect, not verified values.
#
# Model options:
#   mimo-v2.5      ~$0.105 in / $0.28 out per 1M   <- use this
#   mimo-v2.5-pro  ~$0.348 in / $0.696 out per 1M  <- overkill here

# ============================================================
# DeepSeek (fallback / comparison)
# ============================================================
DEEPSEEK_PROTOCOL=
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# ============================================================
# OpenRouter (one key, many models - handy for A/B testing)
# ============================================================
# OPENROUTER_PROTOCOL=openai
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=xiaomi/mimo-v2.5

# ============================================================
# Historical search (used later, not by the backfill)
# ============================================================
TAVILY_API_KEY=
